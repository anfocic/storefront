# Canonical site URL — used for SEO, canonical tags and the sitemap.
PUBLIC_SITE_URL=https://example.com

# dullahan instance: it receives the contact form (POST /contact) and — when you
# opt in — analytics events (POST /collect). The tracker itself ships with this
# site (public/pt.js); this is just the origin events are sent to. Self-hosted
# backend: https://github.com/intrebit/dullahan
# Set contact_to to your inbox and allow this site's origin (CORS) on the server.
# Leave blank and the form degrades to a "call/email us instead" message.
# Analytics stays OFF until you set a siteId in src/config/dullahan.ts.
PUBLIC_DULLAHAN_URL=
