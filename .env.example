# Canonical site URL — used for SEO, canonical tags and the sitemap.
PUBLIC_SITE_URL=https://example.com

# dullahan instance that handles the contact form (POST /contact).
# Self-hosted, privacy-friendly form + analytics backend:
# https://github.com/intrebit/dullahan
# Set contact_to to your inbox and allow this site's origin (CORS) on the server.
# Leave blank and the form degrades to a "call/email us instead" message.
PUBLIC_DULLAHAN_URL=
