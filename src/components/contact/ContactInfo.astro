---
import { business, content, socialLinks, openingHoursByDay } from "../../config/site.ts";
import Icon from "../shared/Icon.astro";
import OpenBadge from "../OpenBadge.astro";

const [emailUser, emailHost] = business.email.split("@");
const mapsUrl = `https://maps.google.com/?q=${encodeURIComponent(business.mapsQuery)}`;
---

<aside class="cinfo" aria-label="Contact information">
  <h3 class="cinfo__title">{content.sections.contact.infoTitle}</h3>

  <ul class="cinfo__list">
    <li>
      <Icon name="phone" size={20} class="cinfo__icon" />
      <a href={business.phoneHref}>{business.phone}</a>
    </li>
    <li>
      <Icon name="email" size={20} class="cinfo__icon" />
      <a href="#" data-email-user={emailUser} data-email-host={emailHost}>{content.sections.contact.emailLabel}</a>
    </li>
    <li>
      <Icon name="pin" size={20} class="cinfo__icon" />
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer">{business.addressLine}</a>
    </li>
  </ul>

  <div class="cinfo__hours">
    <div class="cinfo__hours-head">
      <span class="cinfo__hours-label">Opening hours</span>
      <OpenBadge />
    </div>
    <ul class="cinfo__hours-list">
      {openingHoursByDay.map((l) => (
        <li>
          <span>{l.label}</span>
          <span>{l.value}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="cinfo__social">
    {socialLinks.map(({ href, label, icon }) => (
      <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
        <Icon name={icon} size={24} />
      </a>
    ))}
  </div>
</aside>

<style>
  .cinfo {
    background: var(--bg-sage);
    border-radius: var(--radius);
    padding: var(--s-8) var(--s-6);
  }

  .cinfo__title {
    font-size: var(--text-lg);
    margin-bottom: var(--s-5);
  }

  .cinfo__list {
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .cinfo__list li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--ink);
  }

  .cinfo__icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .cinfo__list a {
    color: var(--ink);
    transition: color 0.2s var(--ease);
  }

  .cinfo__list a:hover {
    color: var(--accent);
  }

  .cinfo__hours {
    color: var(--ink-2);
    font-size: var(--text-sm);
    margin-bottom: var(--s-5);
  }
  .cinfo__hours-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-2);
  }
  .cinfo__hours-label {
    font-weight: 600;
    color: var(--ink);
  }
  .cinfo__hours-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cinfo__hours-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding: 2px 0;
  }

  .cinfo__social {
    display: flex;
    gap: var(--s-4);
    color: var(--ink-2);
  }

  .cinfo__social a:hover {
    color: var(--accent);
  }
</style>
