---
import { business, content, cta, openingHoursText } from "../../config/site.ts";
const hasImage = Boolean(business.heroImage);
---

<section class:list={["hero", { "hero--centered": !hasImage }]} id="home">
  <div class="hero__inner container">
    <div class="hero__content" data-reveal>
      <span class="eyebrow">{content.hero.eyebrow}</span>
      <h1 class="hero__title">{business.tagline}</h1>
      <p class="hero__lede">{content.hero.lede}</p>
      <div class="hero__actions">
        <a href={cta.href} class="btn btn--primary">{cta.label}</a>
        <a href={content.hero.secondaryCta.href} class="btn btn--ghost">{content.hero.secondaryCta.label}</a>
      </div>
      <p class="hero__meta">{openingHoursText}</p>
    </div>

    {hasImage && (
      <div class="hero__media" data-reveal>
        <div class="hero__blob" aria-hidden="true"></div>
        <img src={business.heroImage} width="360" height="360" alt={business.name} fetchpriority="high" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--s-10);
  }

  .hero--centered .hero__inner {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .hero--centered .hero__title,
  .hero--centered .hero__lede {
    max-width: 20ch;
  }
  .hero--centered .hero__lede { max-width: 46ch; }
  .hero--centered .hero__actions { justify-content: center; }

  .hero__title {
    margin: var(--s-3) 0 var(--s-4);
    font-size: var(--text-3xl);
    max-width: 14ch;
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--ink-2);
    max-width: 40ch;
    margin-bottom: var(--s-6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .hero__meta {
    margin-top: var(--s-5);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .hero__media {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero__media img {
    position: relative;
    width: min(360px, 80%);
    height: auto;
    border-radius: 50%;
    z-index: 1;
  }

  .hero__blob {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 90%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 40% 35%, var(--accent-2), var(--accent));
    border-radius: 46% 54% 58% 42% / 48% 44% 56% 52%;
    opacity: 0.28;
    filter: blur(6px);
    animation: blob 14s var(--ease) infinite;
  }

  @keyframes blob {
    0%, 100% { border-radius: 46% 54% 58% 42% / 48% 44% 56% 52%; }
    50% { border-radius: 58% 42% 45% 55% / 55% 58% 42% 45%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__blob { animation: none; }
  }

  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--s-8);
    }
    .hero__title,
    .hero__lede {
      max-width: none;
    }
    .hero__actions {
      justify-content: center;
    }
    .hero__media {
      order: -1;
    }
  }
</style>
