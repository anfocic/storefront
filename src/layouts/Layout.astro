---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/base.css";

import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import { buildSEO, type SEOOverrides } from "../config/seo.ts";

interface Props {
  seo?: SEOOverrides;
  schemas?: object[];
}

const { seo: seoOverrides = {}, schemas = [] } = Astro.props;
const seo = buildSEO(Astro.url, seoOverrides);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Favicon (replace /favicon.svg with your own) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts -->
    <link
      rel="preload"
      href="/fonts/poppins/poppins-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={seo.robots} />
    <meta name="theme-color" content="#f8f7f3" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={seo.site.siteName} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:image" content={seo.image.url} />
    {seo.image.width && <meta property="og:image:width" content={seo.image.width.toString()} />}
    {seo.image.height && <meta property="og:image:height" content={seo.image.height.toString()} />}
    {seo.image.alt && <meta property="og:image:alt" content={seo.image.alt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image.url} />

    <!-- Structured data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script src="/scripts/reveal.js" is:inline defer></script>
    <script src="/scripts/email.js" is:inline defer></script>
  </body>
</html>
