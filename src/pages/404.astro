---
import Layout from "../layouts/Layout.astro";
import { cta, content } from "../config/site.ts";
---

<Layout seo={{ title: content.notFound.title, noindex: true }}>
  <section class="section notfound container">
    <span class="notfound__mark" aria-hidden="true">404</span>
    <h1>{content.notFound.title}</h1>
    <p>{content.notFound.body}</p>
    <div class="notfound__actions">
      <a href="/" class="btn btn--primary">{content.notFound.backLabel}</a>
      <a href={cta.href} class="btn btn--ghost">{cta.label}</a>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .notfound__mark {
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
  }
  .notfound__actions {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--s-4);
  }
</style>
