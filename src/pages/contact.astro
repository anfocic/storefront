---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactInfo from "../components/contact/ContactInfo.astro";
import { pageSEO, localBusinessSchema } from "../config/seo.ts";
import { content } from "../config/site.ts";
---

<Layout seo={pageSEO.contact} schemas={[localBusinessSchema()]}>
  <section class="section">
    <div class="container">
      <span class="eyebrow" style="display:block;text-align:center">{content.sections.contact.eyebrow}</span>
      <h1 class="section__title">{content.sections.contact.pageTitle}</h1>
      <p class="section__lede">{content.sections.contact.pageLede}</p>
    </div>

    <div class="container contact-grid" data-reveal>
      <ContactInfo />
      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--s-10);
    align-items: start;
    margin-top: var(--s-8);
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }
</style>
