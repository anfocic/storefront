---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import Services from "../components/home/Services.astro";
import ReviewsCarousel from "../components/home/ReviewsCarousel.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactInfo from "../components/contact/ContactInfo.astro";
import { pageSEO, localBusinessSchema } from "../config/seo.ts";
import { services, business, content } from "../config/site.ts";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  provider: { "@type": "LocalBusiness", name: business.name },
  areaServed: `${business.address.locality}, ${business.address.country}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.title, description: s.description },
    })),
  },
};
---

<Layout seo={pageSEO.home} schemas={[localBusinessSchema(), serviceSchema]}>
  <Hero />

  <section id="services" class="section">
    <div class="container">
      <span class="eyebrow" style="display:block;text-align:center">{content.sections.services.eyebrow}</span>
      <h2 class="section__title">{content.sections.services.title}</h2>
      <p class="section__lede">{content.sections.services.lede}</p>
    </div>
    <Services />
  </section>

  <section id="reviews" class="section reviews-section">
    <div class="container">
      <span class="eyebrow" style="display:block;text-align:center">{content.sections.reviews.eyebrow}</span>
      <h2 class="section__title">{content.sections.reviews.title}</h2>
    </div>
    <ReviewsCarousel />
  </section>

  <section id="contact" class="section">
    <div class="container contact-grid" data-reveal>
      <div>
        <span class="eyebrow">{content.sections.contact.eyebrow}</span>
        <h2 class="section__title contact-grid__title">{content.sections.contact.title}</h2>
        <p class="contact-grid__lede">{content.sections.contact.lede}</p>
        <ContactInfo />
      </div>
      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  .reviews-section {
    background: var(--bg-2);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--s-10);
    align-items: start;
  }

  .contact-grid__title {
    text-align: left;
    margin-bottom: var(--s-3);
  }

  .contact-grid__lede {
    color: var(--ink-2);
    margin-bottom: var(--s-6);
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }
</style>
