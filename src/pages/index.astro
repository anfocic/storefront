---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import GallerySection from "../components/sections/GallerySection.astro";
import PricingSection from "../components/sections/PricingSection.astro";
import TeamSection from "../components/sections/TeamSection.astro";
import NewsletterSection from "../components/sections/NewsletterSection.astro";
import BookingSection from "../components/sections/BookingSection.astro";
import { marked } from "marked";
import { pageSEO, localBusinessSchema } from "../config/seo.ts";
import { services, business, homeSections, type HomeSection } from "../config/site.ts";

// type → component. `satisfies` makes adding a HomeSection variant without a
// renderer a compile error.
const registry = {
  hero: HeroSection,
  services: ServicesSection,
  reviews: ReviewsSection,
  contact: ContactSection,
  prose: ProseSection,
  faq: FaqSection,
  gallery: GallerySection,
  pricing: PricingSection,
  team: TeamSection,
  newsletter: NewsletterSection,
  booking: BookingSection,
} satisfies Record<HomeSection["type"], unknown>;

// FAQPage structured data, gathered from every `faq` section on the page. Only
// emitted when at least one FAQ exists.
const faqItems = homeSections.flatMap((s) => (s.type === "faq" ? s.items : []));
const faqSchema =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((it) => ({
          "@type": "Question",
          name: it.q,
          acceptedAnswer: { "@type": "Answer", text: marked.parse(it.a) },
        })),
      }
    : null;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  provider: { "@type": "LocalBusiness", name: business.name },
  areaServed: `${business.address.locality}, ${business.address.country}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.title, description: s.description },
    })),
  },
};
---

<Layout
  seo={pageSEO.home}
  schemas={[localBusinessSchema(), serviceSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  {
    homeSections.map((section) => {
      const Section = registry[section.type];
      return <Section section={section} />;
    })
  }
</Layout>
