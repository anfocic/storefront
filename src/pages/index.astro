---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import { pageSEO, localBusinessSchema } from "../config/seo.ts";
import { services, business, homeSections, type HomeSection } from "../config/site.ts";

// type → component. `satisfies` makes adding a HomeSection variant without a
// renderer a compile error.
const registry = {
  hero: HeroSection,
  services: ServicesSection,
  reviews: ReviewsSection,
  contact: ContactSection,
  prose: ProseSection,
} satisfies Record<HomeSection["type"], unknown>;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  provider: { "@type": "LocalBusiness", name: business.name },
  areaServed: `${business.address.locality}, ${business.address.country}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.title, description: s.description },
    })),
  },
};
---

<Layout seo={pageSEO.home} schemas={[localBusinessSchema(), serviceSchema]}>
  {
    homeSections.map((section) => {
      const Section = registry[section.type];
      return <Section section={section} />;
    })
  }
</Layout>
